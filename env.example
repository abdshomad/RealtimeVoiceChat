# Environment Variables for RealtimeVoiceChat Docker Compose Setup

# Application Configuration
PORT=9002
LOG_LEVEL=INFO
MAX_AUDIO_QUEUE_SIZE=50

# TTS Configuration
# Available TTS engines: kokoro, coqui, orpheus, indonesian
TTS_START_ENGINE=kokoro

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434

# GPU Configuration
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Cache Directories
HF_HOME=/home/appuser/.cache/huggingface
TORCH_HOME=/home/appuser/.cache/torch

# Optional: OpenAI Configuration (if using OpenAI instead of Ollama)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: SSL Configuration (if using HTTPS)
# USE_SSL=false
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem 